    "This permanently removes %@ from your vault.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "This permanently removes %@ from your vault."
          }
        }
      }
    },
    "This permanently removes your Kryptos account from this device along with every vault entry, the encryption key, and all expiry reminders. You will be signed out and this cannot be undone. If you've previously backed up to iCloud or Google Drive, delete those backups separately to remove all copies.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "This permanently removes your Kryptos account from this device along with every vault entry, the encryption key, and all expiry reminders. You will be signed out and this cannot be undone. If you've previously backed up to iCloud or Google Drive, delete those backups separately to remove all copies."
          }
        }
      }
    },
    "This replaces the current local vault with the latest Drive AppData backup.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "This replaces the current local vault with the latest Drive AppData backup."
          }
        }
      }
    },
    "This replaces the current local vault with the latest iCloud backup.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "This replaces the current local vault with the latest iCloud backup."
          }
        }
      }
    },
    "To also remove copies stored in iCloud or Google Drive, delete those backups before deleting your account.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "To also remove copies stored in iCloud or Google Drive, delete those backups before deleting your account."
          }
        }
      }
    },
    "Upgrade to Pro to remove the %@ entry limit and support future development.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Upgrade to Pro to remove the %@ entry limit and support future development."
