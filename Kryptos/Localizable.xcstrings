    "Run on a device with a camera to scan documents.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Run on a device with a camera to scan documents."
          }
        }
      }
    },
    "Scan from another Kryptos app (iOS or Android) to import this entry. Works fully offline — nothing leaves your device.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Scan from another Kryptos app (iOS or Android) to import this entry. Works fully offline — nothing leaves your device."
