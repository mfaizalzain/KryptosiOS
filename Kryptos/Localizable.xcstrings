    },
    "Add an \"Expiry\" field with a date (e.g. 12/2028 or 2028-12-31) and Kryptos will remind you 30, 7, and 1 day before it expires.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Add an \"Expiry\" field with a date (e.g. 12/2028 or 2028-12-31) and Kryptos will remind you 30, 7, and 1 day before it expires."
          }
        }
      }
    },
    "An entry with similar details already exists (%@). Save this anyway?": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "An entry with similar details already exists (%@). Save this anyway?"
          }
        }
      }
    },
    "Backups go to a hidden Google Drive folder only your device can see. Upgrade to Pro to back up to a visible \"KryptosBackups\" folder you can copy or move yourself.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Backups go to a hidden Google Drive folder only your device can see. Upgrade to Pro to back up to a visible \"KryptosBackups\" folder you can copy or move yourself."
          }
        }
      }
    },
    "Choose a standard format so other phones can open contacts, Wi-Fi, messages, maps, events, and payment addresses directly.": {
